# Copy to .env and fill in real values. .env is gitignored — never commit it.

PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/apt_rent
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase Storage — required for property photo and avatar uploads.
# backend/utils/storage.js builds its URLs from these; with either one
# missing, every upload targets "undefined/storage/v1" and fails with an
# opaque fetch error rather than a clear configuration message.
#
# SUPABASE_URL is the project URL from Settings → API.
# SUPABASE_SERVICE_ROLE_KEY is the service_role key (not the anon key) —
# the role key is required because uploading through the storage API needs
# to bypass the public RLS policies.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=